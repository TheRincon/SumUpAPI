{
  "info": {
    "name": "SumUp-API",
    "description": "Run the folders in order against a running stack (docker compose up --build). Error Cases reuses the accounts created by Happy Path.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Create account A with a balance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ]
            },
            "description": "Generates a new ID number on every send, so it can be sent repeatedly.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"address\": \"12 St James Square, London\",\n  \"date_of_birth\": \"1985-12-10\",\n  \"id_number\": \"{{idNumberA}}\",\n  \"initial_balance\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idNumberA\", Math.random().toString(36).slice(2, 14).toUpperCase() + Math.random().toString(36).slice(2, 14).toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set(\"accountA\", body.id);",
                  "pm.test(\"balance is 1000\", function () { pm.expect(body.balance === 1000).to.eql(true); });",
                  "pm.test(\"holder details are not returned\", function () { pm.expect(body.name === undefined).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create account B with zero balance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ]
            },
            "description": "initial_balance is optional and defaults to zero.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alan Turing\",\n  \"address\": \"78 High Street, Hampton\",\n  \"date_of_birth\": \"1990-06-23\",\n  \"id_number\": \"{{idNumberB}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idNumberB\", Math.random().toString(36).slice(2, 14).toUpperCase() + Math.random().toString(36).slice(2, 14).toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set(\"accountB\", body.id);",
                  "pm.test(\"balance is 0\", function () { pm.expect(body.balance === 0).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account A",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountA}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountA}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"balance is 1000\", function () { pm.expect(pm.response.json().balance === 1000).to.eql(true); });"
                ]
              }
            }
          ]
        },
