              "raw": "{\n  \"amount\": 250\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"balance is 250\", function () { pm.expect(pm.response.json().balance === 250).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer from A to B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{accountA}}\",\n  \"to\": \"{{accountB}}\",\n  \"amount\": 400\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test(\"source balance is 600\", function () { pm.expect(body.from.balance === 600).to.eql(true); });",
                  "pm.test(\"destination balance is 650\", function () { pm.expect(body.to.balance === 650).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ledger of account B",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountB}}/ledger",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountB}}",
                "ledger"
              ]
            },
            "description": "Up to 100 entries, newest first. Positive amounts are money in."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "var entries = pm.response.json().entries;",
                  "pm.collectionVariables.set(\"newestEntryId\", entries[0].id);",
                  "pm.test(\"has two entries\", function () { pm.expect(entries.length === 2).to.eql(true); });",
                  "pm.test(\"newest is the transfer\", function () { pm.expect(entries[0].type === \"transfer\" && entries[0].amount === 400 && entries[0].balance_after === 650).to.eql(true); });",
                  "pm.test(\"older is the deposit\", function () { pm.expect(entries[1].type === \"deposit\" && entries[1].balance_after === 250).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get older ledger entries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountB}}/ledger?before={{newestEntryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountB}}",
                "ledger"
              ],
              "query": [
                {
                  "key": "before",
                  "value": "{{newestEntryId}}"
                }
              ]
            },
            "description": "Pass next_before from a previous page as before to fetch the next page."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "var entries = pm.response.json().entries;",
                  "pm.test(\"returns only the older entry\", function () { pm.expect(entries.length === 1 && entries[0].type === \"deposit\").to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
